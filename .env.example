# OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://127.0.0.1:8000
# OPENROUTER_APP_NAME=Chrona Calendar Agent

# Local timezone used for scheduling (IANA name)
TIMEZONE=America/New_York

# Google Calendar (optional overrides)
# GOOGLE_CLIENT_SECRETS=credentials/client_secret.json
# GOOGLE_TOKEN_PATH=credentials/token.json
# GOOGLE_CALENDAR_ID=primary
